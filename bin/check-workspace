#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WORKSPACE_DIR="$(dirname "$REPO_DIR")"

# Ledger repo name (this repo). Adjust if you renamed the ledger clone.
LEDGER_REPO="$(basename "$REPO_DIR")"
EXPECTED_REPOS=("legoESM" "legoESM-ocean-runners" "${LEDGER_REPO}")
PASS=0
FAIL=0
WARN=0

check() {
    local label="$1" result="$2"
    if [ "$result" = "ok" ]; then
        printf "  \033[32m✓\033[0m %s\n" "$label"
        PASS=$((PASS + 1))
    elif [ "$result" = "warn" ]; then
        printf "  \033[33m⚠\033[0m %s\n" "$label"
        WARN=$((WARN + 1))
    else
        printf "  \033[31m✗\033[0m %s\n" "$label"
        FAIL=$((FAIL + 1))
    fi
}

echo "=== lego-world workspace check ==="
echo ""

# 1. All three repos exist
echo "-- Repositories --"
for repo in "${EXPECTED_REPOS[@]}"; do
    repo_path="$WORKSPACE_DIR/$repo"
    if [ -d "$repo_path/.git" ]; then
        check "$repo/ exists and is a git repo" "ok"
    elif [ -d "$repo_path" ]; then
        check "$repo/ exists but is NOT a git repo" "warn"
    else
        check "$repo/ missing" "fail"
    fi
done

echo ""

# 2. AGENTS.md symlink
echo "-- Workspace symlink --"
AGENTS_LINK="$WORKSPACE_DIR/AGENTS.md"
EXPECTED_TARGET="$REPO_DIR/workspace-conventions.md"
if [ -L "$AGENTS_LINK" ]; then
    ACTUAL_TARGET="$(readlink "$AGENTS_LINK")"
    if [ "$ACTUAL_TARGET" = "$EXPECTED_TARGET" ]; then
        check "AGENTS.md symlink -> workspace-conventions.md" "ok"
    else
        check "AGENTS.md symlink points to $ACTUAL_TARGET (expected $EXPECTED_TARGET)" "warn"
    fi
elif [ -f "$AGENTS_LINK" ]; then
    check "AGENTS.md exists but is a regular file (run bin/setup-workspace)" "warn"
else
    check "AGENTS.md missing (run bin/setup-workspace)" "fail"
fi

echo ""

# 3. Runners pin vs legoESM checkout
echo "-- Version alignment --"
RUNNERS_DIR="$WORKSPACE_DIR/legoESM-ocean-runners"
LEGOESM_DIR="$WORKSPACE_DIR/legoESM"

if [ -f "$RUNNERS_DIR/legoESM_version.txt" ] && [ -d "$LEGOESM_DIR/.git" ]; then
    PINNED_COMMIT="$(grep '^commit:' "$RUNNERS_DIR/legoESM_version.txt" | awk '{print $2}' | tr -d ' ')"
    CHECKED_OUT="$(cd "$LEGOESM_DIR" && git rev-parse HEAD 2>/dev/null || echo 'unknown')"
    if [ "$PINNED_COMMIT" = "$CHECKED_OUT" ]; then
        check "legoESM checkout matches runners pin ($PINNED_COMMIT)" "ok"
    else
        check "legoESM checkout ($CHECKED_OUT) != runners pin ($PINNED_COMMIT)" "warn"
    fi
else
    check "Cannot check pin alignment (missing legoESM_version.txt or legoESM repo)" "warn"
fi

# 4. Runners HEAD is tagged
if [ -d "$RUNNERS_DIR/.git" ]; then
    RUNNERS_HEAD="$(cd "$RUNNERS_DIR" && git rev-parse HEAD 2>/dev/null || echo 'unknown')"
    RUNNERS_TAGS="$(cd "$RUNNERS_DIR" && git tag --points-at HEAD 2>/dev/null | grep '^legoesm-' | head -1 || true)"
    if [ -n "$RUNNERS_TAGS" ]; then
        check "Runners HEAD is tagged: $RUNNERS_TAGS" "ok"
    else
        check "Runners HEAD ($RUNNERS_HEAD) is NOT tagged (run sync_legoesm.sh --tag)" "warn"
    fi
fi

echo ""

# 5. Uncommitted changes
echo "-- Working tree --"
for repo in "${EXPECTED_REPOS[@]}"; do
    repo_path="$WORKSPACE_DIR/$repo"
    if [ -d "$repo_path/.git" ]; then
        if (cd "$repo_path" && git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null); then
            check "$repo/ no uncommitted changes" "ok"
        else
            check "$repo/ has uncommitted changes" "warn"
        fi
    fi
done

echo ""
echo "=== Summary: $PASS passed, $WARN warnings, $FAIL failed ==="
if [ "$FAIL" -gt 0 ]; then
    exit 1
fi
